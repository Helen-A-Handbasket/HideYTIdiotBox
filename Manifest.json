{
	"manifest_version": 2,
	"name": "Hide YouTube Fact-Check",
	"version": "1.0",
	"description": "Hides the YouTube fact-checking box",
	"permissions": [ "https://www.youtube.com/*" ],
	"background": {
		"scripts": [ "background.js" ],
		"persistent": false
	},
	"icons": {
		"16": "icon16.ico",
		"48": "icon48.ico",
		"128": "icon128.ico"
	},
	"browser_action": {
		"default_icon": {
			"16": "icon16.ico",
			"48": "icon48.ico",
			"128": "icon128.ico"
		}
	},
	"content_scripts": [
		{
			"matches": [ "https://www.youtube.com/*" ],
			"js": [ "content.js" ]
		}
	]
}
